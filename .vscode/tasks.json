//@IncursioHack
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build + Public Download",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/.vscode/build_public_download.py"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Cardputer",
            "type": "shell",
            "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
            "args": [
                "run",
                "-e",
                "m5stack-cardputer"
            ],
            "options": {
                "env": {
                    "PATH": "C:\\Program Files\\Git\\cmd;${env:PATH}",
                    "PLATFORMIO_BUILD_DIR": "${env:LOCALAPPDATA}\\BruceFirmware\\build"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Upload Cardputer",
            "type": "shell",
            "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\platformio.exe",
            "args": [
                "run",
                "-e",
                "m5stack-cardputer",
                "-t",
                "upload",
                "--upload-port",
                "COM3"
            ],
            "options": {
                "env": {
                    "PATH": "C:\\Program Files\\Git\\cmd;${env:PATH}",
                    "PLATFORMIO_BUILD_DIR": "${env:LOCALAPPDATA}\\BruceFirmware\\build"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
