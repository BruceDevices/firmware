{
    "build": {
      "arduino":{
        "ldscript": "esp32s3_out.ld",
        "partitions": "default_8MB.csv"
      },
      "core": "esp32",
      "extra_flags": [
        "-DLIGHTTRACKER_PLUS",
        "-DARDUINO_LightTracker_Plus",
        "-DARDUINO_USB_MODE=1",
        "-DARDUINO_RUNNING_CORE=1",
        "-DARDUINO_EVENT_RUNNING_CORE=1",
        "-DARDUINO_USB_CDC_ON_BOOT=1"
      ],
      "f_cpu": "240000000L",
      "f_flash": "80000000L",
      "flash_mode": "qio",
      "hwids": [
        [
          "0x303A",
          "0x81E0"
        ]
      ],
      "mcu": "esp32s3",
      "variant": "pinouts"
    },
    "connectivity": [
      "bluetooth",
      "wifi",
      "lora"
    ],
    "debug": {
      "default_tool": "esp-builtin",
      "onboard_tools": [
        "esp-builtin"
      ],
      "openocd_target": "esp32s3.cfg"
    },
    "frameworks": [
      "arduino",
      "espidf"
    ],
    "name": "QRP Labs LightTracker Plus v1.0 (ESP32-S3, 8MB, SX1268)",
    "upload": {
      "flash_size": "8MB",
      "maximum_ram_size": 327680,
      "maximum_size": 8388608,
      "require_upload_port": true,
      "use_1200bps_touch": true,
      "wait_for_upload_port": true,
      "speed": 460800
    },
    "url": "https://github.com/lightaprs/LightTracker-Plus-1.0",
    "vendor": "QRP Labs"
  }
