{
  "build": {
    "arduino": {
      "ldscript": "esp32_out.ld",
      "partitions": "default_16MB.csv"
    },
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_M5STACK_CORE2",
      "-DM5STACK",
      "-DBOARD_HAS_PSRAM",
      "-mfix-esp32-psram-cache-issue",
	    "-mfix-esp32-psram-cache-strategy=memw"
    ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "dio",
    "mcu": "esp32",
    "variant": "pinouts"
  },
  "connectivity": [
    "wifi",
    "bluetooth",
    "ethernet",
    "can"
  ],
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "name": "M5Stack Core2",
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 4521984,
    "maximum_size": 16777216,
    "require_upload_port": true,
    "speed": 460800
  },
  "url": "http://www.m5stack.com",
  "vendor": "M5Stack"
}
